# Python/cache noise
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS/editor noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local machine profiles and environment files
.env
.env.*
!.env.example
profiles/*.env
!profiles/default.env.example

# Agent/browser/session artifacts
.claude/
.codex/
.dark-factory/

# .agents/ is session scratch, except the Codex plugin marketplace manifest,
# which is a shipped artifact. Git will not descend into an excluded directory,
# so the carve-out has to re-include each level.
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
qa-results/
screenshots/
videos/
recordings/
*.har

# Logs and temporary output
*.log
tmp/
temp/

# Working documents are never committed. Plans, decision records, review
# reports, forensics, retros and transcripts are snapshots of a moment, and a
# committed snapshot goes stale the day after it is written. Living
# documentation lives in README.md, references/, and the skills themselves.
# A run of df inside this repo also writes its PRD and QA runbook here.
docs/
plans/

# defensive patterns (publish hardening)
*.pem
*.key
id_rsa*
*.p12
node_modules/
